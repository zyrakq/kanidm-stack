# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=kanidm

IMAGE=kanidm/server:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

START_DELAY=10

# Kanidm server configuration
KANIDM_VERSION=2
KANIDM_LOG_LEVEL=info
KANIDM_BINDADDRESS=[::]:8443

# Database configuration
KANIDM_DB_PATH=/data/kanidm.db

# Certificate configuration
KANIDM_TLS_CHAIN=/certs/chain.pem
KANIDM_TLS_KEY=/certs/key.pem

# Domain configuration
KANIDM_DOMAIN=localhost
KANIDM_ORIGIN=https://localhost:8443
# === STEP CA CONFIGURATION ===
# Nginx proxy configuration
VIRTUAL_PORT=8443
VIRTUAL_HOST=kanidm.local
VIRTUAL_PROTO=https

# Step CA SSL configuration
LETSENCRYPT_HOST=kanidm.local
LETSENCRYPT_EMAIL=john.smith@mail.com

KANIDM_TLS_CHAIN=/certs/${VIRTUAL_HOST}/fullchain.pem
KANIDM_TLS_KEY=/certs/${VIRTUAL_HOST}/key.pem