# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=kanidm-mail-sender

IMAGE=kanidm/tools:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info
KANIDM_LOG_LEVEL=info

KANIDM_NETWORK=kanidm-network