# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=kanidm-admin

IMAGE=kanidm-admin

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

APP_KANIDM__URL=https://kadidm.com
APP_KANIDM__CA_PATH=
# APP_KANIDM__CA_PATH=/certs/kanidm.com/fullchain.pem
APP_KANIDM__VERIFY_CA=true
# === STEP CA CONFIGURATION ===
# Nginx proxy configuration
VIRTUAL_PORT=4000
VIRTUAL_HOST=sso.kanidm.local

# Step CA SSL configuration
LETSENCRYPT_HOST=sso.kanidm.local
LETSENCRYPT_EMAIL=john.smith@mail.com